{
  "schemaVersion": "1.0",
  "purpose": "Landing and product-detail section decisions for a content-first design process; not a visual template set.",
  "families": ["promise", "evidence", "capability", "operation", "decision", "action", "navigation", "detail"],
  "sections": [
    {"id":"promise-copy","family":"promise","role":"한 문장으로 대상과 얻는 결과를 알려준다","needs":["specific-outcome"],"avoid":"제품명만 반복한 제목"},
    {"id":"promise-product","family":"promise","role":"실제 사용 화면이나 물건을 첫 화면에서 보여준다","needs":["real-product-visual"],"avoid":"실물처럼 보이게 만든 임의 목업"},
    {"id":"promise-task","family":"promise","role":"사용자가 하려는 일을 바로 시연한다","needs":["task-example"],"avoid":"상호작용이 기능을 가리는 장식"},
    {"id":"promise-split","family":"promise","role":"약속과 사용 장면을 동시에 보여준다","needs":["specific-outcome","real-product-visual"],"avoid":"양쪽의 정보 무게가 같은 모호한 분할"},
    {"id":"promise-demo","family":"promise","role":"짧은 동작으로 핵심 변화 전후를 증명한다","needs":["working-demo"],"avoid":"재생 실패 시 빈 자리"},
    {"id":"evidence-customers","family":"evidence","role":"실제 고객·도입처를 확인 가능하게 제시한다","needs":["verified-customers"],"avoid":"허가 없는 로고 또는 가짜 고객"},
    {"id":"evidence-metrics","family":"evidence","role":"조건과 단위가 명시된 성과를 보여준다","needs":["verified-metrics"],"avoid":"출처·기간 없는 큰 숫자"},
    {"id":"evidence-review","family":"evidence","role":"구체적인 사용 맥락의 검증된 말을 보여준다","needs":["verified-review"],"avoid":"모호한 찬사나 가짜 별점"},
    {"id":"evidence-case","family":"evidence","role":"문제·적용·결과가 이어지는 사례를 설명한다","needs":["case-study"],"avoid":"결과만 있는 익명 사례"},
    {"id":"evidence-standard","family":"evidence","role":"보안·접근성·품질 보증을 확인 가능한 범위로 전달한다","needs":["verified-claim"],"avoid":"검증되지 않은 배지"},
    {"id":"capability-task-list","family":"capability","role":"사용자 과업별로 기능을 묶는다","needs":["feature-list"],"avoid":"기능 이름만 나열"},
    {"id":"capability-annotated-screen","family":"capability","role":"실제 화면의 중요한 제어와 결과를 연결한다","needs":["real-product-visual","feature-list"],"avoid":"라벨이 화면을 덮는 주석"},
    {"id":"capability-sequence","family":"capability","role":"기능 간 선후 관계를 보여준다","needs":["workflow"],"avoid":"서로 독립인 기능을 가짜 단계로 만듦"},
    {"id":"capability-matrix","family":"capability","role":"여러 옵션의 차이를 같은 기준으로 비교한다","needs":["comparison-data"],"avoid":"빈칸이 많은 과도한 비교표"},
    {"id":"capability-focus","family":"capability","role":"한 가지 차별 능력의 구조와 결과를 깊게 보여준다","needs":["distinctive-feature"],"avoid":"모든 기능을 똑같은 카드 크기로 반복"},
    {"id":"operation-steps","family":"operation","role":"시작부터 결과까지 실제 조작 순서를 설명한다","needs":["workflow"],"avoid":"근거 없는 3단계 공식"},
    {"id":"operation-before-after","family":"operation","role":"같은 조건의 전후 차이를 보여준다","needs":["paired-evidence"],"avoid":"비교 조건이 다른 이미지"},
    {"id":"operation-timeline","family":"operation","role":"시간·일정·배송처럼 시점이 중요한 과정을 보여준다","needs":["time-data"],"avoid":"시간 정보 없는 장식 타임라인"},
    {"id":"operation-walkthrough","family":"operation","role":"사용자가 결과를 직접 바꿔 보는 짧은 데모","needs":["working-demo"],"avoid":"키보드·모션 감소에서 동작하지 않는 데모"},
    {"id":"decision-price","family":"decision","role":"가격·청구 단위·제약을 함께 비교한다","needs":["pricing"],"avoid":"가격만 크고 제한은 숨김"},
    {"id":"decision-comparison","family":"decision","role":"대안 간 차이를 공통 기준으로 판단하게 한다","needs":["comparison-data"],"avoid":"상대 제품의 검증되지 않은 주장"},
    {"id":"decision-faq","family":"decision","role":"결정을 막는 실제 질문에 답한다","needs":["real-questions"],"avoid":"페이지 내용을 질문 형태로 반복"},
    {"id":"decision-eligibility","family":"decision","role":"누가 사용할 수 있는지와 제한을 명시한다","needs":["eligibility-rules"],"avoid":"제외 조건 누락"},
    {"id":"decision-risk","family":"decision","role":"환불·취소·보안·개인정보 등 위험을 줄이는 조건을 설명한다","needs":["policy-facts"],"avoid":"법적 문구를 이해 불가능하게 숨김"},
    {"id":"action-primary","family":"action","role":"한 가지 주요 다음 행동을 선명하게 제시한다","needs":["conversion-action"],"avoid":"동등한 강조 버튼 여러 개"},
    {"id":"action-form","family":"action","role":"필요 최소 정보로 신청·문의·가입을 받는다","needs":["form-contract"],"avoid":"첫 접점에서 불필요한 필드"},
    {"id":"action-secondary","family":"action","role":"아직 결정하지 않은 사람에게 다음 탐색 경로를 준다","needs":["secondary-action"],"avoid":"주 행동과 같은 강조 수준"},
    {"id":"navigation-header","family":"navigation","role":"페이지 내 섹션과 제품의 다른 경로를 구분한다","needs":["information-architecture"],"avoid":"짧은 페이지에 과도한 메뉴"},
    {"id":"navigation-contents","family":"navigation","role":"긴 상세 페이지의 판과 위치를 보여준다","needs":["long-page"],"avoid":"내용이 짧은데 목차를 덧붙임"},
    {"id":"navigation-footer","family":"navigation","role":"정책·연락처·보조 탐색의 끝점을 제공한다","needs":["footer-content"],"avoid":"실제 연락 경로가 없는 장식 푸터"},
    {"id":"detail-use-cases","family":"detail","role":"상황별 선택 이유와 결과를 연결한다","needs":["use-cases"],"avoid":"대상만 바꾸고 같은 문장을 반복"},
    {"id":"detail-spec","family":"detail","role":"구매·도입 판단에 필요한 수치를 표로 제공한다","needs":["spec-data"],"avoid":"단위·조건 없는 수치"},
    {"id":"detail-variants","family":"detail","role":"옵션의 색·크기·기능 차이를 확인하게 한다","needs":["variant-data"],"avoid":"선택 결과가 보이지 않는 스와치"},
    {"id":"detail-gallery","family":"detail","role":"실물의 여러 면과 사용 장면을 검토한다","needs":["real-product-visual"],"avoid":"중복 이미지로 장수만 채움"},
    {"id":"detail-delivery","family":"detail","role":"배송·설치·지원·반품의 조건을 알려준다","needs":["service-policy"],"avoid":"구매 후에만 보이는 핵심 제약"}
  ],
  "journeys": {
    "app": ["promise-product","evidence-review","capability-annotated-screen","operation-steps","decision-risk","action-primary"],
    "saas": ["promise-split","evidence-customers","capability-focus","operation-steps","decision-price","decision-faq","action-primary"],
    "local": ["promise-product","detail-spec","evidence-review","decision-faq","action-primary"],
    "education": ["promise-copy","operation-timeline","evidence-case","decision-price","decision-risk","action-primary"],
    "commerce": ["promise-product","detail-gallery","detail-variants","evidence-review","detail-delivery","action-primary"],
    "event": ["promise-copy","operation-timeline","detail-spec","decision-risk","action-primary"]
